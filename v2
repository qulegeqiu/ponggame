  if (window.top!==window.self) return 'This page is shown inside another page, which blocks motion sensors. Open qulegeqiu.github.io/ponggame directly in Safari or Chrome.';
  if (!window.isSecureContext) return 'Motion sensors only work on https:// pages. Open https://qulegeqiu.github.io/ponggame/';
  if (IS_IOS) return 'iPhone: fully close Safari (swipe it away), open the link again, tap Allow motion sensors, then tap "Allow" in the box your phone shows.';
  return 'Android Chrome: tap ⋮ → Settings → Site settings → Motion sensors → Allowed (or tap the icon left of the web address → Permissions). Then reload this page.';
}
function startSensors(){
  window.removeEventListener('devicemotion',onMotion); window.removeEventListener('deviceorientation',onOrient);
  window.addEventListener('devicemotion',onMotion); window.addEventListener('deviceorientation',onOrient);
  gotSensor=false;
  mcSay('Checking sensors…','Give your phone a little shake!','Waiting…');
  let n=0; const timer=setInterval(()=>{ n++; diag();
    if (gotSensor){ clearInterval(timer); phoneOn=true; mc.hidden=true;
      const b=document.getElementById('btnPhone'); b.classList.add('on'); b.textContent='📱 Phone on';
      toast('Phone mode on: upright = 🌙 UP, upside down = ⭐ DOWN, shake to move!',3500); }
    else if (n>=8){ clearInterval(timer); mcSay('No sensor data yet',blockedHelp(),'Try again'); }
  },400);
}
mcAllow.addEventListener('click',()=>{
  if (typeof DeviceMotionEvent==='undefined' && typeof DeviceOrientationEvent==='undefined'){
    lastAsk='no sensor support'; mcSay('No motion sensors','This device or browser has no motion sensors (a computer?). Use the buttons, or wiggle the controller with your mouse.','Try again'); return; }
  const DME=window.DeviceMotionEvent, DOE=window.DeviceOrientationEvent;
  const askM=DME && typeof DME.requestPermission==='function', askO=DOE && typeof DOE.requestPermission==='function';
  if (!askM && !askO){ lastAsk='no question needed'; startSensors(); return; }   // Android & older iPhones
  // iPhone / iPad: ask right inside the tap, otherwise iOS refuses to show the question
  let p;
  try { p = askM ? DME.requestPermission() : DOE.requestPermission(); }
  catch(e){ lastAsk='error: '+e.message; mcSay('Could not ask for permission',blockedHelp(),'Try again'); return; }
  lastAsk='asking…'; diag();
  Promise.resolve(p).then(r=>{
    lastAsk='answer: '+r;
    if (r==='granted'){
      if (askM && askO) DOE.requestPermission().catch(()=>{});   // same permission on iPhone, so this just confirms it
      startSensors();
    } else mcSay('Motion was not allowed', IS_IOS ? 'Your iPhone said no. Fully close Safari (swipe it away), open the link again and tap "Allow" this time. If it never asks: Settings → Apps → Safari → Advanced → Website Data → remove github.io, then try again.' : blockedHelp(), 'Ask again');
  }).catch(e=>{ lastAsk='error: '+(e && e.message || e); mcSay('Could not ask for permission',blockedHelp(),'Try again'); });
});
document.getElementById('mcSkip').addEventListener('click',()=>{ mc.hidden=true; });
document.getElementById('btnPhone').addEventListener('click',()=>{
