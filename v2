    [[-0.35,0],[0.3,-0.2],[0.1,0.35]].forEach(([hx,hy])=>h.ell(hx*R,yc+hy*R*k,R*0.09,R*0.09*k,{stroke:faint,w:1.4,passes:1}));
  });
