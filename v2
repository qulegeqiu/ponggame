    const padMove=(tt>1.1&&tt<1.5)||(tt>1.95&&tt<2.4)?-1:(tt>5.7&&tt<6.1)||(tt>6.5&&tt<6.95)?1:0;
    rig(p,h,{ spin:f, rot:Math.PI*ease(seg(tt,4.0,4.8))+Math.PI*ease(seg(tt,8.2,8.9)),
      vert:-Math.sin(v1*Math.PI)+Math.sin(v2*Math.PI), vertDir:act(v1)?-1:act(v2)?1:0,
      side:Math.sin(s1*Math.PI*4)+Math.sin(s2*Math.PI*4), sideOn:act(s1)||act(s2),
