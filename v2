function panel(p,h,t,isMoon){
  const w=p.width, hh=p.height, u=Math.min(w,hh)/100, f=t/4*Math.PI*2;
  const r=Math.min(w*0.3,hh*0.38), cx=w*0.42, cy=hh*0.48+Math.sin(f+(isMoon?0:1))*u*2;
  h.ell(cx,hh*0.48+r*1.12,r*0.8,r*0.12,{fill:C.shadow,stroke:null});
  drawCap(p,h,cx,cy,r,isMoon?'moon':'star',Math.sin(f)*0.08);
  const ax=Math.min(w*0.9,cx+r+u*10), len=Math.min(hh*0.55,r*1.6), bob=Math.sin(2*f)*u*2.2, col=isMoon?C.blue:C.sun;
  if (isMoon) h.arrow(ax,hh*0.5+len/2+bob,ax,hh*0.5-len/2+bob,{stroke:col,w:4,head:u*5});
  else        h.arrow(ax,hh*0.5-len/2+bob,ax,hh*0.5+len/2+bob,{stroke:col,w:4,head:u*5});
}

