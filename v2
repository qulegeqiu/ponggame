const IS_IOS=/iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform==='MacIntel' && navigator.maxTouchPoints>1);
function onMotion(e){
  let x,y,z; const a=e.acceleration;
  if (a && a.x!=null){ x=a.x; y=a.y; z=a.z||0; }
  else { const g=e.accelerationIncludingGravity; if (!g || g.x==null) return;
    if (!gAvg) gAvg={x:g.x,y:g.y,z:g.z||0};
    gAvg.x+=(g.x-gAvg.x)*0.1; gAvg.y+=(g.y-gAvg.y)*0.1; gAvg.z+=((g.z||0)-gAvg.z)*0.1;
    x=g.x-gAvg.x; y=g.y-gAvg.y; z=(g.z||0)-gAvg.z; }
  motionN++; gotSensor=true;
  if (Math.hypot(x,y,z)>10 && pageList()[cur].id==='try-it') shake(Math.abs(x)>Math.abs(y)?'side':'vert');
}
function onOrient(e){ if (e.beta==null) return; tiltN++; gotSensor=true;
  if (e.beta>40) setOrient('moon'); else if (e.beta<-40) setOrient('star');
  // backup shake detector for phones that only send tilt data
  if (motionN===0 && lastTilt){ const d=Math.abs(e.beta-lastTilt.b)+Math.abs((e.gamma||0)-lastTilt.g);
    if (d>35 && d<300 && pageList()[cur].id==='try-it') shake(Math.abs((e.gamma||0)-lastTilt.g)>Math.abs(e.beta-lastTilt.b)?'side':'vert'); }
  lastTilt={b:e.beta,g:e.gamma||0};
}
