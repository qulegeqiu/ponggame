<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PONG Controller — How to Play</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Gochi+Hand&family=Patrick+Hand&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.4/p5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{ --paper:#fbf5e6; --ink:#2b2a33; --pink:#ff6f91; --moon:#ffd75e; --sun:#ff9b45; }
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:var(--paper);color:var(--ink);
  font-family:'Patrick Hand',system-ui,sans-serif;-webkit-tap-highlight-color:transparent}
#viewport{position:fixed;inset:0;overflow:hidden;touch-action:pan-y}
#track{display:flex;height:100%;transition:transform .55s cubic-bezier(.65,0,.25,1)}
.page{flex:0 0 100%;height:100%;display:flex;flex-direction:column;align-items:center;
  padding:calc(58px + env(safe-area-inset-top)) 18px calc(84px + env(safe-area-inset-bottom));gap:8px;text-align:center}
h1,h2,.big{font-family:'Gochi Hand','Patrick Hand',cursive;font-weight:400;margin:0;line-height:1.05}
h1{font-size:clamp(40px,9vw,84px)}
h2{font-size:clamp(28px,6.2vw,54px);max-width:900px}
.big{font-size:clamp(54px,14vw,120px);color:var(--pink)}
p{margin:0;font-size:clamp(19px,4.4vw,27px);max-width:760px;line-height:1.25}
.hint{opacity:.7;font-size:clamp(17px,4vw,22px)}
.steps{text-align:left;font-size:clamp(17px,4.1vw,24px)}
.media{position:relative;flex:1 1 auto;width:100%;max-width:960px;min-height:120px}
.media-inner{position:absolute;inset:0;transform-origin:center center;transition:transform .2s}
.sketch{position:absolute;inset:0}
.sketch canvas{display:block}
.media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.empty{position:absolute;inset:0;display:none;align-items:center;justify-content:center;font-size:22px;opacity:.6}
body.editing .empty{display:flex}
.panels{flex:1 1 auto;display:flex;gap:14px;width:100%;max-width:960px;min-height:0}
.panel{flex:1;display:flex;flex-direction:column;min-height:0;gap:4px}
.cap{font-size:clamp(20px,5vw,30px)}
.controls{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.controls button{font-size:20px}
.controls button.on{background:var(--moon)}
#btnShake{background:var(--pink);color:#fff}
#try-it .media{touch-action:none;cursor:grab}
#try-it{position:relative}
#motionCard{position:absolute;inset:0;z-index:8;display:flex;align-items:center;justify-content:center;background:rgba(251,245,230,.82);padding:20px}
#motionCard[hidden]{display:none}
.mc-box{background:#fff;border:3px solid var(--ink);border-radius:22px 16px 24px 14px;box-shadow:4px 5px 0 var(--ink);padding:18px 20px;max-width:420px}
.mc-icon{font-size:46px}
.mc-box h3{font-family:'Gochi Hand',cursive;font-weight:400;font-size:32px;margin:4px 0}
.mc-box p{font-size:20px;margin:0 0 14px}
.mc-btns{display:flex;flex-direction:column;gap:10px}
.mc-main{background:var(--pink);color:#fff;font-size:22px}
#btnPhone.on{background:#9be3b0}
.mc-diag{font:12px/1.4 ui-monospace,Menlo,monospace !important;color:#77737f;margin:10px 0 0 !important;word-break:break-word}
.mc-diag:empty{display:none}
#qrCard{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;background:rgba(251,245,230,.9);padding:20px}
#qrCard[hidden]{display:none}
#qrBox{display:flex;justify-content:center;padding:10px;background:#fff;margin:6px auto 8px;width:max-content;border:2.5px solid var(--ink);border-radius:12px}
#qrBox img,#qrBox canvas{display:block}
.qr-note{font-size:16px !important;margin:6px 0 4px !important;opacity:.75}
#qrUrl{width:100%;font:16px 'Patrick Hand',sans-serif;padding:6px 8px;border:2px solid var(--ink);border-radius:10px;margin-bottom:10px}
#qrCard .mc-box{text-align:center}
@media (max-width:680px){ .panels{flex-direction:column;gap:6px} }
/* page 3: big wiggling "Shake it!" */
.shake-it{font-family:'Gochi Hand','Patrick Hand',cursive;font-size:clamp(58px,16vw,128px);line-height:.95;color:var(--pink);
  display:inline-block;transform-origin:50% 65%;animation:shakeit 1.8s ease-in-out infinite}
@keyframes shakeit{0%,55%,100%{transform:rotate(0) translateX(0)}60%{transform:rotate(-7deg) translateX(-8px)}65%{transform:rotate(7deg) translateX(8px)}
  70%{transform:rotate(-6deg) translateX(-6px)}75%{transform:rotate(6deg) translateX(6px)}82%{transform:rotate(-3deg) translateX(-3px)}88%{transform:rotate(2deg) translateX(2px)}}
h2.small-h2{font-size:clamp(21px,4.8vw,38px)}
.hl{color:var(--pink)}
/* page 4: the game screen — no page arrows, just an Exit button */
body.in-game #nav, body.in-game #pageNum, body.in-game #topbar{display:none}
#try-it{padding-top:calc(12px + env(safe-area-inset-top));padding-bottom:calc(14px + env(safe-area-inset-bottom))}
.game-top{position:relative;width:100%;max-width:960px;min-height:46px;display:flex;align-items:center;justify-content:center;padding:0 86px}
.game-top h2{font-size:clamp(22px,5.4vw,44px)}
.exit{position:absolute;left:0;top:50%;transform:translateY(-50%);background:var(--ink);color:#fff;font-size:18px;padding:6px 12px}
.exit:active{transform:translateY(-50%) translate(2px,3px)}
.game-hint{font-size:clamp(16px,3.9vw,22px)}
/* last page: photo of the real controller + link */
.photo-wrap{position:relative;flex:1 1 auto;width:100%;max-width:960px;min-height:170px}
.photo-wrap .media{position:absolute;inset:0;max-width:none}
.real{position:absolute;left:50%;top:50%;height:96%;margin:0;transform:translate(-50%,-50%) rotate(-3deg);background:#fff;
  padding:8px 8px 4px;border:2.5px solid var(--ink);border-radius:6px;box-shadow:4px 5px 0 var(--ink);display:flex;flex-direction:column;align-items:center}
.real img{height:calc(100% - 30px);width:auto;display:block;border-radius:3px}
.real figcaption{font-size:18px;line-height:26px;white-space:nowrap}
.site-link{font-size:clamp(17px,4.3vw,24px);color:var(--ink);background:#fff;border:2.5px solid var(--ink);border-radius:14px 10px 15px 9px;
  padding:5px 14px;box-shadow:2px 3px 0 var(--ink);text-decoration:none;word-break:break-all}

.chrome{position:fixed;z-index:20;display:flex;align-items:center;gap:8px}
#topbar{top:calc(10px + env(safe-area-inset-top));right:12px}
#pageNum{position:fixed;z-index:20;top:calc(16px + env(safe-area-inset-top));left:16px;font-size:20px;opacity:.6}
#nav{bottom:calc(16px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%)}
button{font-family:inherit;font-size:19px;color:var(--ink);background:#fff;border:2.5px solid var(--ink);
  border-radius:14px 10px 15px 9px;padding:6px 14px;cursor:pointer;box-shadow:2px 3px 0 var(--ink)}
button:active{transform:translate(2px,3px);box-shadow:none}
.arrowBtn{width:46px;height:46px;padding:0;font-size:26px;line-height:1}
.arrowBtn:disabled{opacity:.3}
#dots{display:flex;gap:9px;padding:0 6px}
#dots span{width:13px;height:13px;border:2.5px solid var(--ink);border-radius:50% 45% 55% 48%;cursor:pointer}
#dots span.on{background:var(--pink)}
#editBtn.on{background:var(--pink);color:#fff}

body.editing [data-edit]{outline:2.5px dashed rgba(255,111,145,.75);outline-offset:4px;border-radius:6px;cursor:text}
body.editing [data-edit]:focus{outline-style:solid;background:rgba(255,255,255,.55)}
#editBar{position:fixed;z-index:19;left:50%;transform:translateX(-50%);top:calc(62px + env(safe-area-inset-top));
  display:none;flex-wrap:wrap;justify-content:center;gap:6px;align-items:center;background:#fff;border:2.5px dashed var(--ink);
  border-radius:16px;padding:6px 10px;width:max-content;max-width:calc(100vw - 20px);font-size:17px}
body.editing #editBar{display:flex}
body.editing .page{padding-top:calc(150px + env(safe-area-inset-top))}
#editBar button{font-size:16px;padding:3px 10px;box-shadow:1px 2px 0 var(--ink)}
.sw{width:24px;height:24px;border-radius:50%;border:2px solid var(--ink);cursor:pointer;display:inline-block}
.media-tools{display:none;position:absolute;z-index:5;top:4px;left:50%;transform:translateX(-50%);gap:5px;align-items:center;
  background:#fff;border:2.5px dashed var(--pink);border-radius:14px;padding:5px 8px;white-space:nowrap;font-size:16px}
body.editing .media-tools{display:flex}
.media-tools button{font-size:15px;padding:2px 8px;box-shadow:1px 2px 0 var(--ink)}
body.editing .media{outline:2.5px dashed rgba(143,207,223,.9);outline-offset:-2px;border-radius:14px}
#toast{position:fixed;z-index:30;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);
  background:var(--ink);color:var(--paper);padding:8px 16px;border-radius:12px;font-size:18px;opacity:0;pointer-events:none;transition:opacity .3s;max-width:90vw;text-align:center}
#toast.show{opacity:1}
#r5{position:absolute;left:-99999px;top:0;width:10px;height:10px;overflow:hidden}
</style>
</head>
<body>
<div id="pageNum"></div>
<div id="topbar" class="chrome"><button id="qrBtn">📱 QR</button><button id="editBtn">✏️ Edit</button></div>
<div id="qrCard" hidden>
  <div class="mc-box">
    <h3>Scan to play on your phone</h3>
    <div id="qrBox"></div>
    <p class="qr-note">Link (paste your own share link here if needed):</p>
    <input id="qrUrl" type="url" spellcheck="false">
    <div class="mc-btns"><button id="qrClose">Close</button></div>
  </div>
</div>

<div id="editBar">
  <span>Text:</span>
  <button data-fmt="smaller">A−</button>
  <button data-fmt="bigger">A+</button>
  <span class="sw" data-color="#2b2a33" style="background:#2b2a33"></span>
  <span class="sw" data-color="#ff6f91" style="background:#ff6f91"></span>
  <span class="sw" data-color="#ff9b45" style="background:#ff9b45"></span>
  <span class="sw" data-color="#3a8fb7" style="background:#3a8fb7"></span>
  <span class="sw" data-color="#7a5bd6" style="background:#7a5bd6"></span>
  <button data-fmt="resetText">↺ text</button>
  <button id="addPage">＋ Page</button>
  <button id="delPage" hidden>🗑 Page</button>
  <button id="resetAll">Reset all</button>
</div>

<div id="viewport">
  <div id="track">

    <section class="page" id="cover">
      <h1 data-edit="p1-title">PONG Controller</h1>
      <p data-edit="p1-sub">A clear acrylic pentagon tube that plays Pong when you shake it.</p>
      <div class="media" data-media="p1-img" data-scene="cover"></div>
      <p class="hint" data-edit="p1-hint">Swipe to learn how to play →</p>
    </section>

    <section class="page" id="which-way">
      <h2 data-edit="p2-title">Which side is which?</h2>
      <p data-edit="p2-sub">Hold it upright. The end on top picks the direction.</p>
      <div class="panels">
        <div class="panel">
          <div class="media" data-media="p2-moon" data-scene="moonCap"></div>
          <div class="cap" data-edit="p2-cap1">🌙 Moon on top = <b>UP</b></div>
        </div>
        <div class="panel">
          <div class="media" data-media="p2-star" data-scene="starCap"></div>
          <div class="cap" data-edit="p2-cap2">⭐ Star on top = <b>DOWN</b></div>
        </div>
      </div>
    </section>

    <section class="page" id="shake">
      <div class="shake-it" data-edit="p3-big">Shake it!</div>
      <h2 class="small-h2" data-edit="p3-title-v2">Tilt chooses the direction, <span class="hl">shaking</span> is what moves the paddle!</h2>
      <div class="media" data-media="p3-img" data-scene="shake"></div>
      <p data-edit="p3-sub-v2">Shake it any way — up and down or side to side.<br>🌙 on top → the paddle goes up. ⭐ on top → the paddle goes down.</p>
    </section>

    <section class="page" id="try-it">
      <div class="game-top">
        <button id="exitBtn" class="exit" aria-label="Exit the game">✕ Exit</button>
        <h2 data-edit="p5t-title">Your turn — try it!</h2>
      </div>
      <p class="game-hint" data-edit="p5t-sub-v2">Pick 🌙 (UP) or ⭐ (DOWN), then shake: tap <b>Shake</b>, or wiggle the controller with your finger.</p>
      <div class="media" data-media="p5t-img" data-scene="play"></div>
      <div class="controls">
        <button id="btnMoon" class="on">🌙 Moon = UP</button>
        <button id="btnStar">⭐ Star = DOWN</button>
        <button id="btnShake">👋 Shake!</button>
        <button id="btnPhone">📱 Use my phone</button>
      </div>
      <div id="motionCard" hidden>
        <div class="mc-box">
          <div class="mc-icon">📱</div>
          <h3 id="mcTitle">Play with your real phone?</h3>
          <p id="mcText">Your phone becomes the controller: hold it upright for 🌙 (UP), turn it upside down for ⭐ (DOWN), and shake to move the paddle.</p>
          <div class="mc-btns">
            <button id="mcAllow" class="mc-main">Allow motion sensors</button>
            <button id="mcSkip">Use buttons instead</button>
          </div>
          <p id="mcDiag" class="mc-diag"></p>
        </div>
      </div>
    </section>

    <section class="page" id="have-fun">
      <h2 data-edit="p4-title">You've got it!</h2>
      <div class="big" data-edit="p4-big">Have fun!</div>
      <div class="photo-wrap">
        <div class="media" data-media="p4-img" data-scene="confetti"></div>
        <figure class="real"><img alt="The real PONG controller" src="data:image/jpeg;base64,"><figcaption data-edit="p4-cap">The real controller ✨</figcaption></figure>
      </div>
      <p data-edit="p4-sub">Grab your controller and play a round of Pong.</p>
      <a class="site-link" href="https://qulegeqiu.github.io/ponggame/" target="_blank" rel="noopener">🔗 qulegeqiu.github.io/ponggame</a>
    </section>

  </div>
</div>

<div id="nav" class="chrome">
  <button class="arrowBtn" id="prev" aria-label="Previous page">‹</button>
  <div id="dots"></div>
  <button class="arrowBtn" id="next" aria-label="Next page">›</button>
</div>
<div id="toast"></div>
<div id="r5"></div>

<script>
// noprotect  (tells the p5 editor not to stop long loops)
// PONG Controller — How to Play
// Instance-mode p5.js: every drawing is its own p5 sketch (see setupMedia).

/* ================= SAVED EDITS (this browser only) ================= */
const STORE='pong-controller-guide-v1';
let state={text:{},style:{},media:{},custom:[]};
try { const s=JSON.parse(localStorage.getItem(STORE)||'null'); if (s) state=Object.assign(state,s); } catch(e){}
if (!Array.isArray(state.custom)) state.custom=[];
// view-only: no Edit button, and everyone sees the same page (old browser edits are ignored)
const READ_ONLY=true;
if (READ_ONLY) state={text:{},style:{},media:{},custom:[]};
function save(){ try { localStorage.setItem(STORE,JSON.stringify(state)); return true; } catch(e){ return false; } }
let saveT; function saveSoon(){ clearTimeout(saveT); saveT=setTimeout(save,350); }
function toast(msg,ms){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove('show'),ms||2800); }
const T0=performance.now(); const now=()=>(performance.now()-T0)/1000;

/* ================= COLORS ================= */
const C={ ink:'#2b2a33', paper:'#fbf5e6', face:'#d3f0f6', edge:'#93d0df', moon:'#ffd75e', sun:'#ff9b45', pink:'#ff6f91',
          screen:'#23324a', chalk:'#f4ecd8', shadow:'rgba(43,42,51,0.09)', blue:'#3a8fb7', purple:'#7a5bd6' };

/* ================= HAND-DRAWN HELPERS ================= */
function H(p){
  const j=a=>p.random(-a,a);
  function dens(pts,closed,step){
    const out=[], n=pts.length, segs=closed?n:n-1;
    for (let i=0;i<segs;i++){ const [x1,y1]=pts[i], [x2,y2]=pts[(i+1)%n];
      const k=Math.max(1,Math.ceil(Math.hypot(x2-x1,y2-y1)/step));
      for (let s=0;s<k;s++) out.push([x1+(x2-x1)*s/k, y1+(y2-y1)*s/k]); }
    if (!closed) out.push(pts[n-1]);
    return out;
  }
  function path(pts,closed,o={}){
    const S=p._lw||1, st=o.stroke===undefined?C.ink:o.stroke, w=(o.w||2.6)*S, jj=(o.j===undefined?1.3:o.j)*S, step=(o.step||16)*S;
    if (o.fill){ p.noStroke(); p.fill(o.fill); p.beginShape(); for (const [x,y] of pts) p.vertex(x+j(jj*.5),y+j(jj*.5)); p.endShape(p.CLOSE); }
    if (!st) return;
    p.noFill(); p.stroke(st); p.strokeJoin(p.ROUND); p.strokeCap(p.ROUND);
    const passes=o.passes||2;
    for (let k=0;k<passes;k++){
      p.strokeWeight(k===0?w:w*0.5);
      const d=dens(pts,closed,step).map(([x,y])=>[x+j(jj),y+j(jj)]), m=d.length;
      p.beginShape();
      if (closed){ p.curveVertex(...d[m-1]); for (const q of d) p.curveVertex(...q); p.curveVertex(...d[0]); p.curveVertex(...d[1%m]); }
      else { p.curveVertex(...d[0]); for (const q of d) p.curveVertex(...q); p.curveVertex(...d[m-1]); }
      p.endShape();
    }
  }
  function circlePts(cx,cy,rx,ry){ const n=Math.max(14,Math.round((rx+ry)/2.5/(p._lw||1))), a=[];
    for (let i=0;i<n;i++){ const t=i/n*Math.PI*2; a.push([cx+Math.cos(t)*rx, cy+Math.sin(t)*ry]); } return a; }
  const ell=(cx,cy,rx,ry,o)=>path(circlePts(cx,cy,rx,ry),true,o);
  const line=(x1,y1,x2,y2,o)=>path([[x1,y1],[x2,y2]],false,o);
  const rect=(x,y,w,h,o)=>path([[x,y],[x+w,y],[x+w,y+h],[x,y+h]],true,o);
  function arrow(x1,y1,x2,y2,o={}){ line(x1,y1,x2,y2,o); const a=Math.atan2(y2-y1,x2-x1), s=o.head||14;
    line(x2,y2,x2-Math.cos(a-0.55)*s,y2-Math.sin(a-0.55)*s,o); line(x2,y2,x2-Math.cos(a+0.55)*s,y2-Math.sin(a+0.55)*s,o); }
  function star(x,y,r,col){ line(x-r,y,x+r,y,{stroke:col,w:3}); line(x,y-r,x,y+r,{stroke:col,w:3}); }
  return {path,ell,line,rect,arrow,star};
}

/* ================= SHAPES ================= */
function moon(p,h,r,fill){
  const d=0.72*r, hh=Math.sqrt(r*r-(d/2)*(d/2)), a=Math.atan2(hh,d/2), pts=[];
  for (let t=a;t<=Math.PI*2-a;t+=0.2) pts.push([Math.cos(t)*r,Math.sin(t)*r]);
  for (let t=Math.PI+a;t>=Math.PI-a;t-=0.2) pts.push([d+Math.cos(t)*r,Math.sin(t)*r]);
  p.push(); p.rotate(-0.45); h.path(pts,true,{fill:fill||C.moon,w:2.2,step:10}); p.pop();
}
function starPts(r){ const a=[]; for (let i=0;i<10;i++){ const an=-Math.PI/2+i*Math.PI/5, rr=i%2?r*0.45:r; a.push([Math.cos(an)*rr,Math.sin(an)*rr]); } return a; }
function heartPts(r){ const a=[]; for (let i=0;i<24;i++){ const t=i/24*Math.PI*2;
  a.push([16*Math.pow(Math.sin(t),3)*r/17, -(13*Math.cos(t)-5*Math.cos(2*t)-2*Math.cos(3*t)-Math.cos(4*t))*r/17]); } return a; }
function burstPts(r){ const a=[]; for (let i=0;i<24;i++){ const an=i/24*Math.PI*2, rr=i%2?r*0.78:r; a.push([Math.cos(an)*rr,Math.sin(an)*rr]); } return a; }
function cutout(p,h,kind,r){
  const o={fill:'rgba(255,255,255,0.8)',w:2,step:6};
  if (kind==='star') h.path(starPts(r),true,o);
  else if (kind==='heart') h.path(heartPts(r*0.85),true,o);
  else if (kind==='moon') moon(p,h,r*0.8,'rgba(255,255,255,0.8)');
  else if (kind==='sun') h.path(burstPts(r*1.05),true,o);
}
/* the controller: a tall pentagon tube of clear acrylic.
   moon on the top cap, star on the bottom cap, cut-outs on the sides */
function drawPrism(p,h,o){
  const {x,y,H:Ht,R,spin=0,rot=0}=o, k=0.34;
  const angs=[0,1,2,3,4].map(i=>spin+i*Math.PI*2/5-Math.PI/2);
  const ring=(yc,r=R)=>angs.map(an=>[r*Math.cos(an), yc+r*Math.sin(an)*k]);
  const top=ring(-Ht/2), bot=ring(Ht/2), faint='rgba(43,42,51,0.35)';
  const front=i=>Math.sin(angs[i]+Math.PI/5)>0;
  p.push(); p.translate(x,y); p.rotate(rot);
  h.path(bot,true,{fill:'rgba(196,233,243,0.6)',stroke:faint,w:2,passes:1});
  p.push(); p.translate(0,Ht/2); p.scale(1,k); h.path(starPts(R*0.45),true,{fill:C.sun,w:2.2,step:8}); p.pop();
  for (let i=0;i<5;i++){ if (front(i)) continue; const j=(i+1)%5;
