  h.line(-R*0.5,Ht*0.41,-R*0.78,Ht*0.44,{stroke:'#d33',w:1.6,passes:1});
  h.line(-R*0.5,Ht*0.415,-R*0.74,Ht*0.46,{stroke:C.ink,w:1.6,passes:1});
  const faceW=2*R*Math.sin(Math.PI/5);
  for (let i=0;i<5;i++){ if (!front(i)) continue; const j=(i+1)%5;
    h.path([top[i],top[j],bot[j],bot[i]],true,{fill:'rgba(215,242,249,0.3)',w:2.6});
    const cx=(top[i][0]+top[j][0])/2, cy0=(top[i][1]+top[j][1])/2, sx=Math.max(0.05,Math.abs(top[j][0]-top[i][0])/faceW);
    p.push(); p.translate(cx,cy0+Ht*0.42); p.scale(sx,1); cutout(p,h,['star','sun','moon','heart','star'][i],R*0.3); p.pop();
    [0.25,0.5,0.75].forEach(f=>{ const yy=top[i][1]+Ht*f; h.line(top[i][0]-R*0.06,yy,top[i][0]+R*0.06,yy,{w:1.6,passes:1}); });
  }
  h.line(-R*0.6,-Ht*0.36,-R*0.6,Ht*0.02,{stroke:'rgba(255,255,255,0.95)',w:3.5,passes:1});
  h.line(-R*0.48,-Ht*0.3,-R*0.48,-Ht*0.16,{stroke:'rgba(255,255,255,0.95)',w:2.5,passes:1});
  h.path(top,true,{fill:'rgba(215,242,249,0.75)',w:2.6});
  p.push(); p.translate(0,-Ht/2); p.scale(1,k); moon(p,h,R*0.45); p.pop();
