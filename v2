    rig(p,h,{ spin:f, rot:Math.PI*ease(seg(tt,2.6,3.4))+Math.PI*ease(seg(tt,6.4,7.2)),
      vert:-Math.sin(v1*Math.PI)+Math.sin(v2*Math.PI), vertDir:act(v1)?-1:act(v2)?1:0,
      side:Math.sin(s1*Math.PI*4)+Math.sin(s2*Math.PI*4), sideOn:act(s1)||act(s2),
