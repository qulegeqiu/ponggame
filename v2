/* ================= PICTURES: live p5 drawing → GIF, or your own image ================= */
const recs=[];
function applyMedia(m){
  const k=m.dataset.media, s=state.media[k]||{}, rec=m._rec;
  const img=m.querySelector('img.custom'), gen=m.querySelector('img.gen'), sk=m.querySelector('.sketch'), empty=m.querySelector('.empty');
  img.hidden=!s.src; if (s.src) img.src=s.src; else img.removeAttribute('src');
  const showGif=!s.src && rec && rec.gifReady;
  gen.hidden=!showGif;
  sk.style.visibility=(!s.src && !showGif)?'visible':'hidden';
  empty.style.visibility=(!s.src && !rec)?'visible':'hidden';
  const sc=s.scale||100; m.querySelector('.media-inner').style.transform=`scale(${sc/100})`; m.querySelector('.pct').textContent=sc+'%';
}
function setupMedia(m){
  const k=m.dataset.media;
  m.innerHTML=`<div class="media-inner"><div class="sketch"></div><img class="gen" alt="" hidden><img class="custom" alt="" hidden>
      <div class="empty">＋ Add a picture with 🖼 Replace</div></div>
    <div class="media-tools"><button data-a="replace">🖼 Replace</button><button data-a="draw">✏️ Drawing</button>
      <button data-a="smaller">−</button><span class="pct">100%</span><button data-a="bigger">+</button>
      <input type="file" accept="image/*" hidden></div>`;
  const file=m.querySelector('input[type=file]');
  m.querySelector('.media-tools').addEventListener('click',e=>{
    const a=e.target.dataset.a; if (!a) return; const s=state.media[k]=state.media[k]||{};
    if (a==='replace') file.click();
    if (a==='draw'){ delete s.src; save(); applyMedia(m); }
    if (a==='smaller'||a==='bigger'){ s.scale=clamp((s.scale||100)+(a==='bigger'?10:-10),30,200); save(); applyMedia(m); }
  });
  file.addEventListener('change',()=>{
    const f=file.files[0]; if (!f) return; const r=new FileReader();
    r.onload=()=>{ (state.media[k]=state.media[k]||{}).src=r.result; applyMedia(m);
      if (!save()) toast('Picture shown — but it is too big to remember after reload.'); };
    r.readAsDataURL(f); file.value='';
  });
  const scene=SCENES[m.dataset.scene];
  if (scene){
    const el=m.querySelector('.sketch');
    const rec={m,el,scene,kind:m.dataset.scene,section:m.closest('.page'),ready:false,t:0,gifReady:false};
    m._rec=rec; recs.push(rec);
    rec.p=new p5(p=>{
      let h;
      p.setup=()=>{
        p.createCanvas(Math.max(10,el.clientWidth),Math.max(10,el.clientHeight));
        p.pixelDensity(Math.min(2,window.devicePixelRatio||1));
        p.noLoop(); h=H(p); rec.ready=true;
        new ResizeObserver(()=>{ const W=el.clientWidth, Hh=el.clientHeight;
          if (W>10 && Hh>10 && (W!==p.width||Hh!==p.height)){ p.resizeCanvas(W,Hh); p.redraw(); } }).observe(el);
      };
      p.draw=()=>{ p.clear(); p.randomSeed(Math.floor(rec.t*10));
        try { rec.scene.draw(p,h,rec.t); } catch(e){ if (!window._drawErr){ window._drawErr=1; toast('Drawing error: '+e.message); } } };
    },el);
    if (rec.kind==='play'){
      // tap = shake, wiggle with finger/mouse = shake (up-down or side-to-side)
      let down=null;
      m.addEventListener('pointerdown',e=>{ if (document.body.classList.contains('editing')) return;
        down={x:e.clientX,y:e.clientY,lx:e.clientX,ly:e.clientY,dist:0,ax:0,ay:0,t:now(),fired:false}; });
      m.addEventListener('pointermove',e=>{ if (!down) return;
        const dx=e.clientX-down.lx, dy=e.clientY-down.ly; down.lx=e.clientX; down.ly=e.clientY;
        down.dist+=Math.hypot(dx,dy); down.ax+=Math.abs(dx); down.ay+=Math.abs(dy);
        if (down.dist>70){ shake(down.ax>down.ay?'side':'vert'); down.fired=true; down.dist=0; down.ax=0; down.ay=0; } });
      const up=()=>{ if (down && !down.fired && down.dist<12) shake('vert'); down=null; };
      m.addEventListener('pointerup',up); m.addEventListener('pointercancel',()=>{ down=null; });
    }
  }
  applyMedia(m);
}

/* ---- tiny GIF encoder: the demo drawings are turned into looping GIFs,
        so they keep playing even where the viewer pauses page scripts ---- */
const FPS=10;
// In the p5 editor the live p5 drawing runs smoothly, so no GIF swap (that swap caused a blink).
const USE_GIF=false;
function Bytes(){ this.b=new Uint8Array(1<<16); this.n=0; }
Bytes.prototype.byte=function(v){ if (this.n>=this.b.length){ const nb=new Uint8Array(this.b.length*2); nb.set(this.b); this.b=nb; } this.b[this.n++]=v; };
Bytes.prototype.word=function(v){ this.byte(v&255); this.byte((v>>8)&255); };
Bytes.prototype.str=function(s){ for (let i=0;i<s.length;i++) this.byte(s.charCodeAt(i)); };
const DICT=new Int16Array(4096*256).fill(-1), USED=new Int32Array(4096);
function lzw(ind,out){
  out.byte(8);
  const sb=new Uint8Array(255); let sl=0;
  const put=v=>{ sb[sl++]=v; if (sl===255){ out.byte(255); for (let i=0;i<255;i++) out.byte(sb[i]); sl=0; } };
  let cur=0, nb=0, cs=9, next=258, nu=0;
  const emit=c=>{ cur|=c<<nb; nb+=cs; while (nb>=8){ put(cur&255); cur>>>=8; nb-=8; } };
  const reset=()=>{ for (let i=0;i<nu;i++) DICT[USED[i]]=-1; nu=0; next=258; cs=9; };
  emit(256);
  let prefix=ind[0];
  for (let i=1;i<ind.length;i++){
    const k=ind[i], key=(prefix<<8)|k, c=DICT[key];
    if (c>=0){ prefix=c; continue; }
    emit(prefix);
    if (next===4096){ emit(256); reset(); }
    else { if (next>=(1<<cs)) cs++; DICT[key]=next++; USED[nu++]=key; }
    prefix=k;
  }
  emit(prefix); emit(257);
  if (nb>0) put(cur&255);
  if (sl>0){ out.byte(sl); for (let i=0;i<sl;i++) out.byte(sb[i]); }
  out.byte(0);
  reset();
}
const tick=()=>new Promise(r=>{ const ch=new MessageChannel(); ch.port1.onmessage=()=>r(); ch.port2.postMessage(0); });
let R5=null, RH=null;
async function makeGif(rec){
  const cw=rec.el.clientWidth, ch=rec.el.clientHeight; if (cw<20||ch<20) return;
  const rs=Math.min(2,Math.sqrt(240000/(cw*ch))), fw=Math.round(cw*rs), fh=Math.round(ch*rs);
  R5.resizeCanvas(fw,fh); R5._lw=fw/cw;
  const ctx=R5.drawingContext, N=Math.round(rec.scene.P*FPS);
  // draw one frame at GIF size (line widths scaled to match)
  function draw(i){
    R5.resetMatrix(); R5.background(C.paper); R5.randomSeed(i*7+1);
    const W=R5.width, Hh=R5.height;
    rec.scene.draw(R5,RH,i/FPS);
    return ctx.getImageData(0,0,W,Hh).data;
  }
  // 1) palette from a few frames
  const hist=new Uint32Array(32768), sr=new Float64Array(32768), sg=new Float64Array(32768), sbb=new Float64Array(32768);
  for (let i=0;i<N;i+=Math.max(1,Math.floor(N/10))){
    const d=draw(i);
    for (let q=0;q<d.length;q+=8){ const key=((d[q]>>3)<<10)|((d[q+1]>>3)<<5)|(d[q+2]>>3); hist[key]++; sr[key]+=d[q]; sg[key]+=d[q+1]; sbb[key]+=d[q+2]; }
    await tick();
  }
  const keys=[]; for (let k=0;k<32768;k++) if (hist[k]) keys.push(k);
  keys.sort((a,b)=>hist[b]-hist[a]);
  const pal=keys.slice(0,256).map(k=>[sr[k]/hist[k],sg[k]/hist[k],sbb[k]/hist[k]].map(Math.round));
  while (pal.length<256) pal.push([0,0,0]);
  const lut=new Int16Array(32768).fill(-1);
  const near=key=>{ const r=((key>>10)<<3)+4, g=(((key>>5)&31)<<3)+4, b=((key&31)<<3)+4; let bi=0, bd=1e9;
    for (let i=0;i<256;i++){ const c=pal[i], dd=(c[0]-r)**2+(c[1]-g)**2+(c[2]-b)**2; if (dd<bd){ bd=dd; bi=i; } } return bi; };
  // 2) frames
  const out=new Bytes();
  out.str('GIF89a'); out.word(fw); out.word(fh); out.byte(0xF7); out.byte(0); out.byte(0);
  for (const c of pal){ out.byte(c[0]); out.byte(c[1]); out.byte(c[2]); }
  out.byte(0x21); out.byte(0xFF); out.byte(11); out.str('NETSCAPE2.0'); out.byte(3); out.byte(1); out.word(0); out.byte(0);
  const ind=new Uint8Array(fw*fh), delay=Math.round(100/FPS);
  for (let i=0;i<N;i++){
    const d=draw(i);
    for (let q=0,pi=0;pi<ind.length;q+=4,pi++){ const key=((d[q]>>3)<<10)|((d[q+1]>>3)<<5)|(d[q+2]>>3); let v=lut[key]; if (v<0) v=lut[key]=near(key); ind[pi]=v; }
    out.byte(0x21); out.byte(0xF9); out.byte(4); out.byte(0x04); out.word(delay); out.byte(0); out.byte(0);
    out.byte(0x2C); out.word(0); out.word(0); out.word(fw); out.word(fh); out.byte(0);
    lzw(ind,out);
    await tick();
  }
  out.byte(0x3B);
  const blob=new Blob([out.b.subarray(0,out.n)],{type:'image/gif'});
  const gen=rec.m.querySelector('img.gen');
  const tryLoad=src=>new Promise(res=>{ gen.onload=()=>res(gen.naturalWidth>0); gen.onerror=()=>res(false); gen.src=src; });
  // show the GIF only if it really loads; otherwise keep the live drawing
  let ok=await tryLoad(URL.createObjectURL(blob));
  if (!ok){ const dataUrl=await new Promise(r=>{ const fr=new FileReader(); fr.onload=()=>r(fr.result); fr.onerror=()=>r(null); fr.readAsDataURL(blob); });
    if (dataUrl) ok=await tryLoad(dataUrl); }
  if (ok){ try { if (gen.decode) await gen.decode(); } catch(e){}   // fully decoded first, so the swap doesn't flash
    rec.gifReady=true; applyMedia(rec.m); } else gen.removeAttribute('src');
}
async function makeAllGifs(){
  const order=recs.filter(r=>r.kind!=='play');
  for (const r of order){ try { await makeGif(r); } catch(e){ console.log('gif failed',e); } }
}

