  showMotionCard();
});

/* ================= PAGES & NAVIGATION ================= */
const track=document.getElementById('track'), dots=document.getElementById('dots');
const pageList=()=>[...document.querySelectorAll('.page')];
let cur=0, lastNav=0;
function refreshNav(){
  const pg=pageList(); dots.innerHTML='';
  pg.forEach((_,i)=>{ const d=document.createElement('span'); d.onclick=()=>go(i); dots.appendChild(d); });
  go(Math.min(cur,pg.length-1));
}
function go(i){
  const pg=pageList(); cur=clamp(i,0,pg.length-1); lastNav=Date.now();
  track.style.transform=`translateX(${-cur*100}%)`;
  [...dots.children].forEach((d,k)=>d.classList.toggle('on',k===cur));
  document.getElementById('prev').disabled=cur===0;
  document.getElementById('next').disabled=cur===pg.length-1;
  document.getElementById('pageNum').textContent=`${cur+1} / ${pg.length}`;
  document.getElementById('delPage').hidden=!pg[cur].classList.contains('custom');
  document.body.classList.toggle('in-game', pg[cur].id==='try-it');
  if (pg[cur].id==='try-it' && !mcShown && !phoneOn && 'ontouchstart' in window) showMotionCard();
}
// leave the game: go to the last page
function exitGame(){ const i=pageList().findIndex(p=>p.id==='have-fun'); go(i>=0?i:cur+1); }
document.getElementById('exitBtn').addEventListener('click',exitGame);
const navOK=()=>Date.now()-lastNav>600;
window.addEventListener('hashchange',()=>{ const i=pageList().findIndex(pg=>pg.id===location.hash.slice(1)); if (i>=0 && i!==cur) go(i); });
document.getElementById('prev').onclick=()=>go(cur-1);
document.getElementById('next').onclick=()=>go(cur+1);
const typing=()=>document.activeElement && (document.activeElement.isContentEditable || document.activeElement.tagName==='INPUT');
window.addEventListener('keydown',e=>{ if (typing()) return;
  if (pageList()[cur].id==='try-it'){
    if (e.key==='ArrowUp'||e.key==='m'){ e.preventDefault(); setOrient('moon'); return; }
    if (e.key==='ArrowDown'||e.key==='s'){ e.preventDefault(); setOrient('star'); return; }
    if (e.key===' '||e.key==='Enter'){ e.preventDefault(); shake('vert'); return; }
    if (e.key==='Escape'){ e.preventDefault(); exitGame(); return; }
    return; }   // no page-flipping keys inside the game
  if (e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){ e.preventDefault(); go(cur+1); }
  if (e.key==='ArrowLeft'||e.key==='PageUp'){ e.preventDefault(); go(cur-1); } });
let sx=null, sy=0;
const vp=document.getElementById('viewport');
vp.addEventListener('pointerdown',e=>{
  sx=null; if (!e.isPrimary) return;
  if (document.body.classList.contains('editing') && e.target.closest('[data-edit],.media-tools')) return;
  if (pageList()[cur].id==='try-it') return;   // the game page doesn't swipe; use Exit
  sx=e.clientX; sy=e.clientY; });
vp.addEventListener('pointerup',e=>{ if (sx===null) return; const dx=e.clientX-sx, dy=e.clientY-sy; sx=null;
  if (Math.abs(dx)>45 && Math.abs(dx)>Math.abs(dy)*1.2 && navOK()) go(cur+(dx<0?1:-1)); });
vp.addEventListener('pointercancel',()=>{ sx=null; });
vp.addEventListener('wheel',e=>{ if (typing() || !navOK() || pageList()[cur].id==='try-it') return; const d=Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY;
  if (Math.abs(d)<25) return; go(cur+(d>0?1:-1)); },{passive:true});

/* ================= EDITABLE TEXT ================= */
let lastText=null;
function bindEditable(el){
  const k=el.dataset.edit; el.dataset.def=el.innerHTML;
  if (state.text[k]!=null) el.innerHTML=state.text[k];
  applyStyle(el);
  if (document.body.classList.contains('editing')) el.setAttribute('contenteditable','true');
  el.addEventListener('input',()=>{ state.text[k]=el.innerHTML; saveSoon(); });
  el.addEventListener('focus',()=>{ lastText=el; });
  el.addEventListener('paste',e=>{ e.preventDefault(); document.execCommand('insertText',false,(e.clipboardData||window.clipboardData).getData('text/plain')); });
}
function applyStyle(el){ const st=state.style[el.dataset.edit]||{}; el.style.fontSize=st.fs?st.fs+'px':''; el.style.color=st.color||''; }
const editBtn=document.getElementById('editBtn');
if (READ_ONLY) editBtn.remove();   // the edit bar only shows in edit mode, so it stays hidden too
editBtn.onclick=()=>{
  const on=!document.body.classList.contains('editing');
  document.body.classList.toggle('editing',on);
  editBtn.classList.toggle('on',on); editBtn.textContent=on?'✓ Done':'✏️ Edit';
  document.querySelectorAll('[data-edit]').forEach(el=>on?el.setAttribute('contenteditable','true'):el.removeAttribute('contenteditable'));
  if (on) toast('Tap any text to edit it. Picture buttons change pictures. ＋ Page adds a page.');
  else { if (document.activeElement) document.activeElement.blur(); save(); toast('Saved in this browser ✓'); }
};
document.querySelectorAll('#editBar [data-fmt], #editBar .sw').forEach(b=>b.addEventListener('mousedown',e=>e.preventDefault()));
document.querySelectorAll('#editBar [data-fmt]').forEach(b=>b.addEventListener('click',()=>{
  if (!lastText) return toast('Tap a piece of text first');
  const k=lastText.dataset.edit, st=state.style[k]=state.style[k]||{}, act=b.dataset.fmt;
  if (act==='resetText'){ lastText.innerHTML=lastText.dataset.def; delete state.text[k]; delete state.style[k]; applyStyle(lastText); save(); return; }
  const fs=parseFloat(getComputedStyle(lastText).fontSize);
  st.fs=Math.round(clamp(fs*(act==='bigger'?1.12:0.89),10,220)); applyStyle(lastText); save();
}));
document.querySelectorAll('#editBar .sw').forEach(s=>s.addEventListener('click',()=>{
  if (!lastText) return toast('Tap a piece of text first');
  (state.style[lastText.dataset.edit]=state.style[lastText.dataset.edit]||{}).color=s.dataset.color; applyStyle(lastText); save();
}));
const resetAll=document.getElementById('resetAll'); let armed=false;
resetAll.onclick=()=>{
  if (!armed){ armed=true; resetAll.textContent='Tap again to reset'; setTimeout(()=>{ armed=false; resetAll.textContent='Reset all'; },3000); return; }
  state={text:{},style:{},media:{},custom:[]}; save(); location.reload();
