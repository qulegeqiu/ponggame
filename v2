  }},
  fun:{P:6, draw(p,h,t){
    const w=p.width, hh=p.height, u=Math.min(w,hh)/100, f=t/6*Math.PI*2, cols=[C.pink,C.moon,C.sun,C.blue,C.purple];
    for (let i=0;i<28;i++){
      const x=((i*0.6180339)%1)*w, sp=(1+i%2)/6;
      const y=(((t*sp+i*0.173)%1)*1.15-0.08)*hh, r=u*(1.6+(i%3)), a=f*(1+i%3)+i, col=cols[i%5];
