}
function drawCap(p,h,cx,cy,r,kind,rot){
  const pts=[0,1,2,3,4].map(i=>{ const a=-Math.PI/2+i*Math.PI*2/5; return [Math.cos(a)*r,Math.sin(a)*r]; });
  p.push(); p.translate(cx,cy); p.rotate(rot);
  h.path(pts.map(([a,b])=>[a,b+r*0.13]),true,{fill:C.edge,w:2});
  h.path(pts,true,{fill:C.face,w:2.8});
  h.line(-r*0.55,-r*0.15,-r*0.3,-r*0.55,{stroke:'rgba(255,255,255,0.95)',w:3.5,passes:1});
  if (kind==='moon') moon(p,h,r*0.5); else h.path(starPts(r*0.55),true,{fill:C.sun,w:2.4,step:8});
  p.pop();
}
function drawPong(p,h,x,y,w,ht,leftY,ballX,ballY,rightY){
  const S=p._lw||1;
  h.rect(x,y,w,ht,{fill:C.screen,w:3.2});
  for (let yy=y+ht*0.06; yy<y+ht*0.94; yy+=ht*0.11) h.line(x+w/2,yy,x+w/2,yy+ht*0.05,{stroke:C.chalk,w:2,passes:1});
  const pw=Math.max(6*S,w*0.035), ph=ht*0.26, m=w*0.06;
  const ly=y+ht/2+leftY*(ht/2-ph/2-ht*0.04), ry=y+ht/2+rightY*(ht/2-ph/2-ht*0.04);
  h.rect(x+m,ly-ph/2,pw,ph,{fill:C.chalk,stroke:C.chalk,w:2,passes:1});
  h.rect(x+w-m-pw,ry-ph/2,pw,ph,{fill:C.chalk,stroke:C.chalk,w:2,passes:1});
  const br=Math.max(5*S,w*0.022);
  const bx=x+m+pw+br+(w-2*m-2*pw-2*br)*ballX, by=y+br+(ht-2*br)*ballY;
  h.ell(bx,by,br,br,{fill:C.moon,stroke:C.chalk,w:1.6,passes:1});
  return {lx:x+m+pw, ly, ph, bx, by, br};
}

const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const seg=(t,a,b)=>clamp((t-a)/(b-a),0,1);
const ease=x=>x<0.5?2*x*x:1-Math.pow(-2*x+2,2)/2;
const tri=x=>1-4*Math.abs((((x%1)+1)%1)-0.5);
const lerp=(a,b,f)=>a+(b-a)*f;

/* controller + Pong screen side by side.
   o: rot, spin, vert (-1..1 shake offset), side (-1..1), vertDir, sideOn, arrow (-1 up / 1 down), padY, bx, by, padMove */
function rig(p,h,o){
  const w=p.width, hh=p.height, u=Math.min(w,hh)/100;
  const Ht=Math.min(hh*0.72,w*0.95), R=Ht*0.17, px=Math.max(R*1.25+u*3,w*0.18), py=hh/2, A=Ht*0.12;
  const x=px+(o.side||0)*A*0.55, y=py+(o.vert||0)*A;
  if (o.vertDir) for (let k=-1;k<=1;k++){ const yy = o.vertDir<0 ? y+Ht/2+u*3 : y-Ht/2-u*11; h.line(x+k*R*0.6,yy,x+k*R*0.6,yy+u*8,{w:2.4}); }
  if (o.sideOn) for (const sgn of [-1,1]) for (const f of [-0.15,0.15]) h.line(px+sgn*(R*1.35+u*2),py+f*Ht-u*4,px+sgn*(R*1.35+u*2),py+f*Ht+u*4,{w:2.4});
  drawPrism(p,h,{x,y,H:Ht,R,spin:o.spin||0,rot:o.rot||0});
  const ax=px+R*1.35+u*7;
  if (o.arrow) h.arrow(ax,py-o.arrow*Ht*0.18,ax,py+o.arrow*Ht*0.18,{stroke:C.pink,w:3.6,head:u*4});
  const gx=ax+u*6; let gw=w-gx-u*2, gh=Math.min(hh*0.86,gw*0.9); if (gw>gh*1.5) gw=gh*1.5;
  const gy=(hh-gh)/2;
  const r=drawPong(p,h,gx,gy,gw,gh,o.padY||0,o.bx,o.by,o.rightY!==undefined?o.rightY:clamp((o.by-0.5)*2,-1,1));
  if (o.padMove) h.arrow(r.lx+u*5,r.ly-o.padMove*u*5,r.lx+u*5,r.ly+o.padMove*u*6,{stroke:C.pink,w:3,head:u*2.6});
  if (o.burst){ for (let i=0;i<7;i++){ const a=i/7*Math.PI*2; h.line(r.bx+Math.cos(a)*r.br*1.8,r.by+Math.sin(a)*r.br*1.8,r.bx+Math.cos(a)*r.br*3,r.by+Math.sin(a)*r.br*3,{stroke:C.moon,w:2.4,passes:1}); } }
  return {r,gx,gy,gw,gh,u};
}

