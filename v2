/* ================= EXTRA PAGES ================= */
function buildCustom(c){
  const sec=document.createElement('section'); sec.className='page custom'; sec.id=c.id;
  sec.innerHTML=`<h2 data-edit="${c.id}-title">New page</h2>
    <div class="media" data-media="${c.id}-img"></div>
    <p data-edit="${c.id}-text">Write something here…</p>`;
  const anchor=document.getElementById(c.after);
  if (anchor) anchor.after(sec); else document.getElementById('have-fun').before(sec);
  sec.querySelectorAll('[data-edit]').forEach(bindEditable);
  setupMedia(sec.querySelector('.media'));
}
document.getElementById('addPage').onclick=()=>{
  const c={id:'pg-'+Date.now().toString(36), after:pageList()[cur].id};
  state.custom.push(c); save(); buildCustom(c); refreshNav(); go(cur+1);
};
document.getElementById('delPage').onclick=()=>{
  const sec=pageList()[cur]; if (!sec.classList.contains('custom')) return;
  const c=state.custom.find(x=>x.id===sec.id);
  state.custom.forEach(x=>{ if (x.after===sec.id) x.after=c.after; });
  state.custom=state.custom.filter(x=>x.id!==sec.id);
  ['-title','-text'].forEach(s=>{ delete state.text[sec.id+s]; delete state.style[sec.id+s]; }); delete state.media[sec.id+'-img'];
  save(); sec.remove(); refreshNav(); go(cur-1);
