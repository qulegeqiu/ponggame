// live drawing for the page on screen (the try-it game, and the demos until their GIF is ready)
function liveTick(){
  const t=now(), sec=pageList()[cur];
  recs.forEach(r=>{ if (r.ready && r.section===sec && (r.kind==='play' || !r.gifReady) && t-(r.t||0)>0.03){ r.t=t; r.p.redraw(); } });
