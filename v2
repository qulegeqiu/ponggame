const G={ orient:'moon', rot:0, padY:0, padTarget:0, shakeT:-9, shakeKind:'vert', shakeDir:-1, hits:0, misses:0,
          msg:'Shake to move your paddle!', msgT:0, lastT:null, pause:1.5, ball:{x:0.6,y:0.4,vx:-0.26,vy:0.22} };
function say(m){ G.msg=m; G.msgT=now(); }
function setOrient(o){ if (G.orient===o) return; G.orient=o;
  document.getElementById('btnMoon').classList.toggle('on',o==='moon');
  document.getElementById('btnStar').classList.toggle('on',o==='star'); }
function shake(kind){ if (now()-G.shakeT<0.25) return;
  G.shakeT=now(); G.shakeKind=kind||'vert'; G.shakeDir=G.orient==='moon'?-1:1;
  G.padTarget=clamp(G.padTarget+G.shakeDir*0.45,-1,1); }
function playDraw(p,h,t){
  const dt=G.lastT==null?0:clamp(t-G.lastT,0,0.05); G.lastT=t;
  G.rot+=((G.orient==='moon'?0:Math.PI)-G.rot)*Math.min(1,dt*7);
  G.padY+=(G.padTarget-G.padY)*Math.min(1,dt*10);
  const age=now()-G.shakeT, on=age<0.5, b=G.ball;
  if (G.pause>0) G.pause-=dt;
  else { b.x+=b.vx*dt; b.y+=b.vy*dt;
    if (b.y<0){ b.y=-b.y; b.vy=Math.abs(b.vy); } if (b.y>1){ b.y=2-b.y; b.vy=-Math.abs(b.vy); }
    if (b.x>=1){ b.x=1; b.vx=-Math.abs(b.vx); b.vy=(Math.random()*2-1)*0.35; } }
  const L=rig(p,h,{ spin:t*0.4, rot:G.rot,
    vert: on&&G.shakeKind==='vert' ? Math.sin(age/0.5*Math.PI)*G.shakeDir : 0, vertDir: on&&G.shakeKind==='vert' ? G.shakeDir : 0,
    side: on&&G.shakeKind==='side' ? Math.sin(age/0.5*Math.PI*4) : 0, sideOn: on&&G.shakeKind==='side',
    padY:G.padY, bx:clamp(b.x,0,1), by:b.y });
  const r=L.r;
  if (b.x<=0 && G.pause<=0){
    if (Math.abs(r.by-r.ly)<=r.ph/2+r.br){ b.x=0; b.vx=Math.min(0.55,Math.abs(b.vx)*1.08); G.hits++; say(['Nice catch! ✨','Great shake!','You got it!'][G.hits%3]); }
    else { G.misses++; say(r.by<r.ly?'Missed! Ball was higher → 🌙 = UP, then shake':'Missed! Ball was lower → ⭐ = DOWN, then shake');
      b.x=0.6; b.y=0.2+Math.random()*0.6; b.vx=-0.26; b.vy=(Math.random()*2-1)*0.3; G.pause=1.6; }
  }
  const {gx,gy,gw,gh}=L;
  p.noStroke(); p.fill(C.chalk); p.textFont('Patrick Hand'); p.textAlign(p.CENTER,p.TOP);
  p.textSize(Math.max(13,gh*0.075)); p.text('Catches: '+G.hits+'    Misses: '+G.misses,gx+gw/2,gy+gh*0.03);
  if (now()-G.msgT<2.6 || G.hits+G.misses===0){ p.textSize(Math.max(14,gh*0.08)); p.fill(C.moon); p.textAlign(p.CENTER,p.BOTTOM);
    p.text(G.msg,gx+gw*0.05,gy+gh*0.55,gw*0.9,gh*0.42); }
}
